# Safe, non-production values used only by CI validation.
# Never use this file as a production environment file.

HOST_STORAGE_PATH=/tmp/presentation-coaching-ci-storage
APP_TIME_ZONE=Asia/Seoul

DB_NAME=presentation_coaching_ci
DB_USERNAME=ci_user
MYSQL_PASSWORD=ci-password-only
MYSQL_ROOT_PASSWORD=ci-root-password-only
DB_HOST=mysql
DB_PORT=3306
DB_PASSWORD=ci-password-only
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=1

JWT_SECRET=ci-only-secret-must-never-be-used-outside-automated-tests-1234567890
APP_ENV=development
APP_BASE_URL=http://localhost
FRONTEND_ORIGINS=http://localhost:5173,http://localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
TRUST_PROXY_HEADERS=false

RATE_LIMIT_LOGIN_PER_MINUTE=3
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_REFRESH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_HOUR=10
RATE_LIMIT_ANALYSIS_PER_HOUR=10
RATE_LIMIT_RETRY_PER_HOUR=10
RATE_LIMIT_ADMIN_PER_MINUTE=30
RATE_LIMIT_API_PER_MINUTE=60

TLS_CERTIFICATE_PATH=/tmp/ci/tls/fullchain.pem
TLS_PRIVATE_KEY_PATH=/tmp/ci/tls/privkey.pem
BACKUP_ROOT=/tmp/presentation-coaching-ci-backups
BACKUP_RETENTION_DAYS=1
BACKUP_KEEP_MINIMUM=1
BACKUP_INCLUDE_TEMP_ARTIFACTS=false

STORAGE_ROOT=/app/storage
ANALYSIS_RECOVERY_MAX_ATTEMPTS=1
ANALYSIS_ENGINE_BASE_URL=http://analysis-engine:8001
VIDEO_LLM_ENGINE_BASE_URL=http://video-llm-engine:8002

STT_PROVIDER=NONE
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STT_LANGUAGE=ko
HF_HOME=/app/storage/models/huggingface
FACE_DETECTION_CONFIDENCE=0.3
FACE_TRACKING_CONFIDENCE=0.3
FACE_ANALYSIS_MAX_WIDTH=1280
FACE_CROP_RETRY_ENABLED=true
FACE_CROP_PADDING_RATIO=0.25
FACE_CROP_MIN_SIZE=256
AUDIO_VAD_PROVIDER=RMS
AUDIO_VAD_FALLBACK_PROVIDER=RMS
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=350
VAD_SPEECH_PAD_MS=100
VAD_MERGE_GAP_MS=200
SILERO_VAD_THRESHOLD=0.5
SILERO_VAD_MODEL_PATH=

OLLAMA_BASE_URL=http://127.0.0.1:9
TEXT_LLM_PROVIDER=NONE
TEXT_LLM_MODEL=qwen3:4b
TEXT_LLM_TIMEOUT_SECONDS=1

VIDEO_LLM_PROVIDER=NONE
VIDEO_LLM_MODEL=nvidia/nemotron-nano-12b-v2-vl
VIDEO_LLM_FALLBACK_PROVIDER=NONE
OLLAMA_VIDEO_LLM_MODEL=qwen3-vl:4b
NVIDIA_API_BASE_URL=http://127.0.0.1:9
NVIDIA_API_KEY=
NVIDIA_REQUEST_TIMEOUT_SECONDS=1
NVIDIA_MAX_TOKENS=256
NVIDIA_TEMPERATURE=0.2
NVIDIA_TOP_P=1.0
NVIDIA_MAX_IMAGES=2
NVIDIA_MAX_PAYLOAD_MB=2
