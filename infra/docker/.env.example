# Copy this file to infra/docker/.env and replace secret values.
# Do not commit infra/docker/.env.

# Host paths
HOST_STORAGE_PATH=D:/presentation-coaching-storage

# MySQL container
APP_TIME_ZONE=Asia/Seoul
DB_NAME=presentation_coaching_ai
DB_USERNAME=presentation
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# Backend database connection
DB_HOST=mysql
DB_PORT=3306
DB_PASSWORD=change-me

# Backend security
JWT_SECRET=replace-with-at-least-32-byte-secret

# Shared storage path inside containers
STORAGE_ROOT=/app/storage
ANALYSIS_RECOVERY_MAX_ATTEMPTS=3

# Internal service URLs used by backend
ANALYSIS_ENGINE_BASE_URL=http://analysis-engine:8001
VIDEO_LLM_ENGINE_BASE_URL=http://video-llm-engine:8002

# analysis-engine
STT_PROVIDER=FASTER_WHISPER
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STT_LANGUAGE=ko
HF_HOME=/app/storage/models/huggingface
FACE_DETECTION_CONFIDENCE=0.3
FACE_TRACKING_CONFIDENCE=0.3
FACE_ANALYSIS_MAX_WIDTH=1280
FACE_CROP_RETRY_ENABLED=true
FACE_CROP_PADDING_RATIO=0.25
FACE_CROP_MIN_SIZE=256
AUDIO_VAD_PROVIDER=RMS
AUDIO_VAD_FALLBACK_PROVIDER=RMS
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=350
VAD_SPEECH_PAD_MS=100
VAD_MERGE_GAP_MS=200
SILERO_VAD_THRESHOLD=0.5
SILERO_VAD_MODEL_PATH=

# LLM / Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
TEXT_LLM_PROVIDER=OLLAMA
TEXT_LLM_MODEL=qwen3:4b
TEXT_LLM_TIMEOUT_SECONDS=30

# Video LLM
VIDEO_LLM_PROVIDER=NVIDIA_NIM
VIDEO_LLM_MODEL=nvidia/nemotron-nano-12b-v2-vl
VIDEO_LLM_FALLBACK_PROVIDER=OLLAMA
OLLAMA_VIDEO_LLM_MODEL=qwen3-vl:4b
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_API_KEY=
NVIDIA_REQUEST_TIMEOUT_SECONDS=180
NVIDIA_MAX_TOKENS=4096
NVIDIA_TEMPERATURE=0.2
NVIDIA_TOP_P=1.0
NVIDIA_MAX_IMAGES=8
NVIDIA_MAX_PAYLOAD_MB=20

# Reserved for future OpenAI integration. Currently unused by docker-compose.yml.
OPENAI_API_KEY=
OPENAI_MODEL=
