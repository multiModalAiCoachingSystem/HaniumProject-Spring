# Copy this file to infra/docker/.env and replace secret values.
# Do not commit infra/docker/.env.

# Host paths
HOST_STORAGE_PATH=../../storage

# MySQL container
DB_NAME=presentation_coaching_ai
DB_USERNAME=presentation
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# Backend database connection
DB_HOST=mysql
DB_PORT=3306
DB_PASSWORD=change-me

# Backend security
JWT_SECRET=replace-with-at-least-32-byte-secret

# Shared storage path inside containers
STORAGE_ROOT=/data

# Internal service URLs used by backend
ANALYSIS_ENGINE_BASE_URL=http://analysis-engine:8001
VIDEO_LLM_ENGINE_BASE_URL=http://video-llm-engine:8002

# analysis-engine
STT_PROVIDER=FASTER_WHISPER
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STT_LANGUAGE=ko
HF_HOME=/data/models/huggingface

# LLM / Ollama
TEXT_LLM_PROVIDER=OLLAMA
TEXT_LLM_MODEL=qwen3:4b
VIDEO_LLM_PROVIDER=OLLAMA
VIDEO_LLM_MODEL=qwen3-vl:4b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Reserved for future OpenAI integration. Currently unused by docker-compose.yml.
OPENAI_API_KEY=
OPENAI_MODEL=
