HOST_STORAGE_PATH=D:/presentation-coaching-storage
DB_HOST=mysql
DB_PORT=3306
DB_NAME=presentation_coaching_ai
DB_USERNAME=presentation
# For Docker Compose, DB_PASSWORD should match MYSQL_PASSWORD.
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
DB_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-byte-secret
STORAGE_ROOT=/app/storage
ANALYSIS_ENGINE_BASE_URL=http://analysis-engine:8001
VIDEO_LLM_ENGINE_BASE_URL=http://video-llm-engine:8002
TEXT_LLM_PROVIDER=OLLAMA
OLLAMA_BASE_URL=http://host.docker.internal:11434
TEXT_LLM_MODEL=qwen3:4b
VIDEO_LLM_PROVIDER=NVIDIA_NIM
VIDEO_LLM_MODEL=nvidia/nemotron-nano-12b-v2-vl
VIDEO_LLM_FALLBACK_PROVIDER=OLLAMA
OLLAMA_VIDEO_LLM_MODEL=qwen3-vl:4b
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_API_KEY=
NVIDIA_REQUEST_TIMEOUT_SECONDS=180
NVIDIA_MAX_TOKENS=4096
NVIDIA_TEMPERATURE=0.2
NVIDIA_TOP_P=1.0
NVIDIA_MAX_IMAGES=8
NVIDIA_MAX_PAYLOAD_MB=20
OPENAI_API_KEY=
OPENAI_MODEL=
