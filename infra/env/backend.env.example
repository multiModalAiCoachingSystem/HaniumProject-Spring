HOST_STORAGE_PATH=D:/presentation-coaching-ai/storage
DB_HOST=mysql
DB_PORT=3306
DB_NAME=presentation_coaching_ai
DB_USERNAME=presentation
# For Docker Compose, DB_PASSWORD should match MYSQL_PASSWORD.
MYSQL_PASSWORD=your_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here
DB_PASSWORD=your_password_here
JWT_SECRET=your_jwt_secret_here
STORAGE_ROOT=/data
ANALYSIS_ENGINE_BASE_URL=http://analysis-engine:8001
VIDEO_LLM_ENGINE_BASE_URL=http://video-llm-engine:8002
TEXT_LLM_PROVIDER=OLLAMA
OLLAMA_BASE_URL=http://host.docker.internal:11434
TEXT_LLM_MODEL=qwen3:4b
